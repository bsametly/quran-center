# انسخ هذا الملف إلى .env.local للتطوير، واضبط القيم نفسها في Vercel → Environment Variables
# ملاحظة أمنية: المفتاح هنا هو Anon Key العام (آمن للواجهة) — لا تضع Service Role Key هنا أبداً

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# بدون هذين المتغيرين يعمل التطبيق تلقائياً بالوضع التجريبي (بيانات محلية كاملة)
